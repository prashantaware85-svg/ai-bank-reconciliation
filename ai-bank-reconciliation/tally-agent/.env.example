# Local agent configuration (copy to .env — never commit secrets).
# TallyPrime HTTP/XML endpoint (F1 → Settings → Connectivity in TallyPrime).
# Either set the full base URL, or host + port separately:
TALLY_BASE_URL=http://127.0.0.1:9000
# TALLY_HOST=127.0.0.1
# TALLY_PORT=9000
# Request timeout in milliseconds.
TALLY_TIMEOUT_MS=20000
# Backend API base URL (outbound HTTPS in production).
BACKEND_URL=http://127.0.0.1:3001
# Logged-in user's JWT (outbound auth). Obtain via the app login page.
BACKEND_JWT=
