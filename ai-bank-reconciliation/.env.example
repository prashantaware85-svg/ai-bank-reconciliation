# AI Bank Reconciliation — environment template.
# Copy to .env (dev) or .env.prod (production) and fill in REAL values.
# NEVER commit files containing real secrets. Generate secrets with:
#   openssl rand -hex 32   (JWT secrets, min 32 chars)
#   openssl rand -hex 32   (ENCRYPTION_KEY)

# --- Runtime ---
# development | production | test
NODE_ENV=development
# Backend listen port (prod compose uses 3001 internally)
PORT=3001

# --- PostgreSQL (prod compose reads POSTGRES_*; backend uses DATABASE_URL) ---
POSTGRES_USER=bankapp
POSTGRES_PASSWORD=change-me-use-a-long-random-password
POSTGRES_DB=bank_reconciliation
# Local dev default (native Postgres or dev compose on localhost:5432):
DATABASE_URL=postgresql://bankapp:change-me-use-a-long-random-password@localhost:5432/bank_reconciliation?schema=public
# In production the backend container resolves `postgres` via compose DNS:
# DATABASE_URL=postgresql://bankapp:change-me-use-a-long-random-password@postgres:5432/bank_reconciliation?schema=public

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379
# Production (compose DNS):
# REDIS_URL=redis://redis:6379

# --- Auth (REQUIRED, min 32 chars each) ---
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
JWT_REFRESH_SECRET=change-me-generate-with-openssl-rand-hex-32
ENCRYPTION_KEY=change-me-generate-with-openssl-rand-hex-32

# --- CORS: comma-separated origins, or * for local dev only ---
CORS_ORIGIN=http://localhost:3000

# --- AI provider (optional; analysis falls back to deterministic heuristics) ---
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
# AI_BASE_URL=https://api.openai.com/v1

# --- Tally connector (legacy variable; the local agent uses BACKEND_URL) ---
TALLY_CONNECTOR_URL=

# --- Frontend (baked into the client bundle at build time) ---
# Local dev:
NEXT_PUBLIC_API_URL=http://localhost:3001
# Production (public backend URL, normally via reverse proxy):
# NEXT_PUBLIC_API_URL=https://your-domain.example.com/api
