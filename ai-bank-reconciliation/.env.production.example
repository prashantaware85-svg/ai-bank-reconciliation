# AI Bank Reconciliation — PRODUCTION environment template.
# Copy to .env.prod and fill in REAL values. NEVER commit .env.prod.
# Generate secrets with:  openssl rand -hex 32   (use a fresh value per key)
#
# Required in production (compose fails fast if missing):
#   POSTGRES_USER, POSTGRES_PASSWORD, JWT_SECRET, JWT_REFRESH_SECRET,
#   ENCRYPTION_KEY, NEXT_PUBLIC_API_URL

# --- Runtime ---
NODE_ENV=production
PORT=3001

# --- PostgreSQL (container credentials; app reaches it as host `postgres`) ---
POSTGRES_USER=bankapp
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
POSTGRES_DB=bank_reconciliation
DATABASE_URL=postgresql://bankapp:REPLACE_WITH_LONG_RANDOM_PASSWORD@postgres:5432/bank_reconciliation?schema=public

# --- Redis (container DNS name) ---
REDIS_URL=redis://redis:6379

# --- Auth signing keys (REQUIRED, min 32 chars each, all different) ---
JWT_SECRET=REPLACE_WITH_openssl_rand_hex_32
JWT_REFRESH_SECRET=REPLACE_WITH_openssl_rand_hex_32
ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_hex_32

# --- CORS: production frontend origin(s) ONLY, comma-separated. Never "*" ---
CORS_ORIGIN=https://app.example.com

# --- AI provider (optional; deterministic fallback when unset) ---
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
# AI_BASE_URL=https://api.openai.com/v1

# --- Frontend (baked into the client bundle at image build time) ---
# Must be the PUBLIC backend URL served over HTTPS via the reverse proxy.
NEXT_PUBLIC_API_URL=https://api.example.com

# --- Domains (placeholders — replace with your real domains) ---
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com

# --- Tally Agent runs on the Windows PC, NOT in compose (reference only) ---
# TALLY_BASE_URL=http://127.0.0.1:9000
# BACKEND_URL=https://api.example.com
# BACKEND_JWT=<paste a login JWT from the app; never commit it>
